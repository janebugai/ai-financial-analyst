# Flask CLI entrypoint (optional if you run `python app.py`).
FLASK_APP=app.py

# Required for generated analysis. Used by DSPy and the OpenAI fallback.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Required for signed sessions (PDF download uses session["latest_insight"]).
# Generate a value, then paste the hex string here:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-hex-string

# Optional. Defaults to 5000.
PORT=5000
